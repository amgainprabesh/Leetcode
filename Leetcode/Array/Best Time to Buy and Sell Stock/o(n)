class Solution:
    def maxProfit(self, prices: List[int]) -> int:
        profit=0
        min=prices[0]
        for i in range(1,len(prices)):
            if prices[i]<min:
                min = prices[i]
            elif prices[i]-min >profit:
                profit=prices[i]-min
        return profit

